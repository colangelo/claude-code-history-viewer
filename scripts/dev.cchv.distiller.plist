<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- dev.cchv.distiller — hourly journal-entries distiller (docs/archive/deployment.md §3c).
     Interval job, NOT KeepAlive: the distiller is catch-up-based (work list derived
     from hub data), and an idle tick is one loopback query + exit (no LLM calls), so
     it ticks hourly (StartInterval) rather than once nightly. Interval ticks are what
     make the pipeline self-healing: the FIRST tick after the 04:00 UTC logical day-close
     sees it regardless of DST offset (the old 05:30-LOCAL calendar run fired 03:30 UTC
     under CEST — before the close — so it never saw yesterday), and a failed tick
     retries at the next tick instead of +24h.

     STALENESS IS BOUNDED IN WAKES, NOT HOURS, and on this host those are very different
     units. launchd does NOT fire StartInterval while the machine is asleep; a DarkWake
     is not a wake; and the whole run of missed intervals is coalesced into ONE catch-up
     at the next full wake rather than replayed. Measured 2026-08-21: 3h45m with zero
     ticks and `state = not running`, across a Sleep<->DarkWake cycle. This host sleeps
     40-106x/day, so "N groups / 50 per hourly tick" is a FLOOR on the drain time, never
     an estimate — never predict a clear-by time from the interval. RunAtLoad adds
     login/boot catch-up. Each tick records itself via POST /v1/journal/ticks, which is
     what makes "no tick has run" visible in /v1/healthz/journal instead of inferable
     only from this log. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.cchv.distiller</string>
    <!-- zsh -lc gives a sane PATH via .zprofile, but NOT CLAUDE_CONFIG_DIR: that
         export lives in ~/.zshrc, which non-interactive login shells never read
         (the relay poller works because relay-poll.sh exports it itself). Without
         it claude -p resolves stale credentials and every call 401s, so it must
         be set here explicitly. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>/Users/ac/.local/bin/cchv-distill</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CCHV_NONINTERACTIVE</key>
        <string>1</string>
        <key>CLAUDE_CONFIG_DIR</key>
        <string>/Users/ac/.config/claude</string>
    </dict>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/tmp/cchv-distiller.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/cchv-distiller.err</string>
</dict>
</plist>
